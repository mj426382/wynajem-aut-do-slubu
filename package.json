{
  "name": "wynajem-aut-do-slubu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/generate-blog-index.js && vite",
    "build": "node scripts/check-redirects.js && node scripts/generate-blog-index.js && node scripts/generate-sitemap.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "build:client": "node scripts/generate-blog-index.js && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "blog-index": "node scripts/generate-blog-index.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "check:redirects": "node scripts/check-redirects.js",
    "check:blog": "python scripts/blog/check_blog_duplicates.py",
    "check:build": "node scripts/check-build.js",
    "images": "node scripts/generate-images.js",
    "indexnow:dry": "node scripts/indexnow.js --sha HEAD --dry-run --no-key-check"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.35.5",
    "vite": "^8.0.1"
  }
}
