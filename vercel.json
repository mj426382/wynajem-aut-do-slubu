{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "autodosluburadom.pl" }],
      "destination": "https://autodoslubuwarszawa.pl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.autodoslubuwarszawa.pl" }],
      "destination": "https://autodoslubuwarszawa.pl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.autodosluburadom.pl" }],
      "destination": "https://autodoslubuwarszawa.pl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "wynajem-aut-do-slubu.vercel.app" }],
      "destination": "https://autodoslubuwarszawa.pl/$1",
      "permanent": true
    },
    { "source": "/blog/wynajem-auta-do-slubu-warszawa", "destination": "/auto-do-slubu-warszawa", "statusCode": 301 },
    { "source": "/blog/wynajem-auta-do-slubu-radom", "destination": "/auto-do-slubu-radom", "statusCode": 301 },
