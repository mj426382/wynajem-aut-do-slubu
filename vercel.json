    { "source": "/blog/wynajem-auta-do-slubu-w-otwocku-2026", "destination": "/blog/wynajem-auta-do-slubu-otwock", "statusCode": 301 },
    { "source": "/blog/wynajem-auta-do-slubu-w-otwocku-poradnik", "destination": "/blog/wynajem-auta-do-slubu-otwock", "statusCode": 301 },
    { "source": "/blog/wynajem-auta-do-slubu-w-otwocku-porady", "destination": "/blog/wynajem-auta-do-slubu-otwock", "statusCode": 301 },
    { "source": "/blog/wynajem-auta-do-slubu-w-grojcu", "destination": "/blog/wynajem-auta-do-slubu-grojec", "statusCode": 301 },
    { "source": "/blog/kabriolet-bmw-na-slub-dlaczego-warto", "destination": "/blog/bmw-4-cabrio-na-slub-latem", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
